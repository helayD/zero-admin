info (
	desc:   "会员相关"
	author: "koobe"
	email:  "1002219331@qq.com"
)

// Story 3.1.1: 旧的 LoginReq / RegisterReq（手机号+密码）已下线，
// 全站统一为「手机号 + 短信验证码」合并登录注册接口。
//
// 接口契约:
//   POST /api/member/auth/sms/send   发送验证码（mock 固定 123456，生产走阿里云等真实 provider）
//   POST /api/member/auth/login      验证码登录注册合并（已注册→登录；未注册→自动建号）

type LoginData {
	Token     string `json:"token"`
	TokenHead string `json:"tokenHead"`
	IsNewUser bool   `json:"isNewUser,omitempty"`
}

type SmsLoginReq {
	Mobile string `json:"mobile"` //手机号
	Code   string `json:"code"`   //6 位短信验证码（mock 模式固定为 123456）
	Source int32  `json:"source,default=1"` //登录来源：0-PC，1-APP，2-小程序
}

type SmsLoginResp {
	Code    int64     `json:"code"`
	Message string    `json:"message"`
	Data    LoginData `json:"data"`
}

type SendSmsCodeReq {
	Mobile string `json:"mobile"` //手机号
	Scene  int32  `json:"scene,default=1"` //1=member_login
}

type SendSmsCodeData {
	ExpireSeconds int32 `json:"expireSeconds"`
}

type SendSmsCodeResp {
	Code    int64           `json:"code"`
	Message string          `json:"message"`
	Data    SendSmsCodeData `json:"data"`
}

type InfoResp {
	Code    int64      `json:"code"`
	Message string     `json:"message"`
	Data    MemberData `json:"data"`
}

type MemberData {
	Id           int64   `json:"id"` //主键ID
	MemberId     int64   `json:"memberId"` //会员ID
	LevelId      int64   `json:"levelId"` //等级ID
	Nickname     string  `json:"nickname"` //昵称
	Mobile       string  `json:"mobile"` //手机号码
	Source       int32   `json:"source"` //注册来源：0-PC，1-APP，2-小程序
	Avatar       string  `json:"avatar"` //头像
	Signature    string  `json:"signature"` //个性签名
	Gender       int32   `json:"gender"` //性别：0-未知，1-男，2-女
	Birthday     string  `json:"birthday"` //生日
	GrowthPoint  int32   `json:"growthPoint"` //成长值
	Points       int32   `json:"points"` //积分
	TotalPoints  int32   `json:"totalPoints"` //累计获得积分
	SpendAmount  float64 `json:"spendAmount"` //累计消费金额
	OrderCount   int32   `json:"orderCount"` //订单数
	CouponCount  int32   `json:"couponCount"` //优惠券数量
	CommentCount int32   `json:"commentCount"` //评价数
	ReturnCount  int32   `json:"returnCount"` //退货数
	LotteryTimes int32   `json:"lotteryTimes"` //剩余抽奖次数
	LastLogin    string  `json:"lastLogin"` //最后登录
	RealNameStatus string `json:"realNameStatus"` //实名状态
	RealNameStatusText string `json:"realNameStatusText"` //实名状态文案
	RealNameMasked string `json:"realNameMasked"` //脱敏实名
	CredentialRef string `json:"credentialRef"` //凭证引用
	VerifiedAt string `json:"verifiedAt"` //实名时间
}

type UpdatePasswordReq {
	Password string `json:"password"` //密码
}

type UpdateMemberReq {
	Id        int64  `json:"id"` //主键ID
	Nickname  string `json:"nickname"` //昵称
	Mobile    string `json:"mobile"` //手机号码
	Avatar    string `json:"avatar"` //头像
	Signature string `json:"signature"` //个性签名
	Gender    int32  `json:"gender"` //性别：1-男，2-女
	Birthday  string `json:"birthday,optional"` //生日
}

type MemberResp {
	Code    string `json:"code"`
	Message string `json:"message"`
}

@server (
	group:    member/member
	prefix:   /api/member
	tags:     "用户管理"
	authType: apiKey
)
service front-api {
	// Story 3.1.1: 发送手机号短信验证码（mock 固定 123456，生产走真实 provider）
	@handler AuthSendSmsCode
	post /auth/sms/send (SendSmsCodeReq) returns (SendSmsCodeResp)

	// Story 3.1.1: 手机号+验证码合并登录注册（已注册→登录；未注册→自动建号）
	@handler AuthLogin
	post /auth/login (SmsLoginReq) returns (SmsLoginResp)
}

@server (
	jwt:      Auth
	group:    member/member
	prefix:   /api/member
	tags:     "会员管理"
	authType: apiKey
)
service front-api {
	// 获取会员个人信息
	@handler Info
	get /info returns (InfoResp)

	// 更新会员密码
	@handler UpdatePassword
	post /updatePassword (UpdatePasswordReq) returns (MemberResp)

	// 更新会员信息
	@handler UpdateMember
	post /updateMember (UpdateMemberReq) returns (MemberResp)
}
