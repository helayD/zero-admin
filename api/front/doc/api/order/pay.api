info (
	desc:   "订单支付信息"
	author: "koobe"
	email:  "1002219331@qq.com"
)

type OrderPayReq {
	OrderId int64  `json:"orderId"`
	PayType int64  `json:"payType"` // 支付方式：1=支付宝，2=微信
	Remark  string `json:"remark,optional"`
}

type OrderPayResp {
	Code    int64  `json:"code"`
	Message string `json:"message"`
	Data    string `json:"data"` // 支付唤起参数（支付宝orderInfo字符串 / 微信mweb_url）
}

type OrderPayQueryReq {
	OrderId int64 `json:"orderId"`
}

type OrderPayQueryResp {
	Code        int64  `json:"code"`
	Message     string `json:"message"`
	Data        string `json:"data"`
	OrderStatus int64  `json:"orderStatus"` // 0=待支付 1=已支付 2=已取消
	PayStatus   int64  `json:"payStatus"` // 0=未支付 1=已支付
	ExpireTime  int64  `json:"expireTime"` // 剩余支付秒数
}

@server (
	jwt:      Auth
	group:    order/pay
	prefix:   /api/order
	tags:     "支付管理"
	authType: apiKey
)
service front-api {
	//对订单进行支付
	@handler OrderPay
	post /orderPay (OrderPayReq) returns (OrderPayResp)

	//查询订单支付状态
	@handler OrderPayQuery
	get /orderPayQuery/:orderId (OrderPayQueryReq) returns (OrderPayQueryResp)
}

@server (
	group:    order/pay
	prefix:   /api/pay
	tags:     "支付回调用通知"
	authType: apiKey
)
service front-api {
	//支付回调用通知
	@handler Notify
	post /notify
}

